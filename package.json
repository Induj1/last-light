{
  "name": "last-light",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "description": "An offline electricity allocation game for Engineers' Day.",
  "scripts": {
    "dev": "concurrently -k -n engine,display -c green,cyan \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "start:hosted": "node server/hosted.js",
    "test": "node --test tests/*.test.js",
    "audio": "node scripts/generate-audio.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "serialport": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.6",
    "vite": "^6.3.6"
  }
}
